# Copy to .env. Keep API keys and GitHub tokens out of Git.

# Local Gemini API mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ARTEX_LOCAL_MODE=auto

# Google Cloud deployment (used by deployment/deploy.py).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_MODEL_LOCATION=global
STAGING_BUCKET=

# Optional Agent Engine resource for Cloud mode.
AGENT_ENGINE_RESOURCE_NAME=
VERTEX_AGENT_RESOURCE=

# GitHub repository for status checks: owner/repo.
GITHUB_REPOSITORY=znaukitai/Artex-AI
GITHUB_TOKEN=
